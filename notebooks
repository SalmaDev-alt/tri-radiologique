    "## 6. Multimodal OpenI (image + texte) — optionnel, le plus lourd\n",
    "\n",
    "Cette partie télécharge le dataset OpenI depuis Kaggle (~14 Go) via kagglehub.\n",
    "\n",
    "**Authentification Kaggle requise.** Si la cellule de téléchargement demande des identifiants :\n",
    "allez sur kaggle.com > votre profil > Settings > \"Create New Token\", cela télécharge un fichier\n",
    "`kaggle.json`. Puis exécutez la cellule d'authentification ci-dessous pour le téléverser."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# (À n'exécuter que si le téléchargement demande une authentification)\n",
    "from google.colab import files\n",
    "print(\"Téléversez votre fichier kaggle.json :\")\n",
    "uploaded = files.upload()\n",
    "import os, shutil\n",
    "os.makedirs(\"/root/.kaggle\", exist_ok=True)\n",
    "shutil.move(\"kaggle.json\", \"/root/.kaggle/kaggle.json\")\n",
    "os.chmod(\"/root/.kaggle/kaggle.json\", 0o600)\n",
    "print(\"kaggle.json installé.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Téléchargement OpenI + mise en forme attendue par src/data_openi.py\n",
    "!pip install -q kagglehub\n",
    "import kagglehub, glob, os, shutil\n",
    "from pathlib import Path\n",
    "\n",
    "src_path = kagglehub.dataset_download(\"raddar/chest-xrays-indiana-university\")\n",
    "print(\"Dataset téléchargé dans :\", src_path)\n",
    "\n",
    "# Repérer automatiquement les CSV et le dossier d'images PNG\n",
    "reports = glob.glob(os.path.join(src_path, \"**\", \"indiana_reports.csv\"), recursive=True)\n",
    "projections = glob.glob(os.path.join(src_path, \"**\", \"indiana_projections.csv\"), recursive=True)\n",
    "png_dirs = {}\n",
    "for p in glob.glob(os.path.join(src_path, \"**\", \"*.png\"), recursive=True):\n",
    "    d = os.path.dirname(p); png_dirs[d] = png_dirs.get(d, 0) + 1\n",
    "images_dir = max(png_dirs, key=png_dirs.get) if png_dirs else None\n",
    "print(\"reports:\", reports[:1], \"| projections:\", projections[:1], \"| images:\", images_dir)\n",
    "\n",
    "# Construire la structure attendue : ./data/openi/{images/, *.csv}\n",
    "target = Path(\"data/openi\"); target.mkdir(parents=True, exist_ok=True)\n",
    "shutil.copy(reports[0], target / \"indiana_reports.csv\")\n",
    "shutil.copy(projections[0], target / \"indiana_projections.csv\")\n",
    "link = target / \"images\"\n",
    "if link.exists() or link.is_symlink():\n",
    "    link.unlink()\n",
    "os.symlink(images_dir, link)\n",
    "print(\"Structure OpenI prête dans ./data/openi\")\n"
   ]
